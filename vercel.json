{
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!sw\\.js|manifest\\.json|images/|assets/|favicon\\.png|.*\\.(?:js|css|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf)).*)",
      "destination": "/"
    }
  ],
  "github": {
    "silent": false,
    "autoAlias": true
  }
}
